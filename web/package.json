{
  "name": "fundledger-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && node scripts/write-headers.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/oxlint/bin/oxlint --deny-warnings src",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "gen:api": "node node_modules/openapi-typescript/bin/cli.js ../api/openapi/fundledger-api.json -o src/lib/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "dexie": "^4.4.7",
    "i18next": "^26.5.10",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
