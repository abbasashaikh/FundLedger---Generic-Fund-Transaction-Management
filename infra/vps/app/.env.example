# Copy to /opt/fundledger/<env>/.env on the VPS (chmod 600). NEVER commit the real file.
# Keep comments on their own lines: deploy.sh parses these values.

# staging | production
FL_ENV=staging
# Set by deploy.sh
IMAGE_TAG=
# Staging | Production
ASPNETCORE_ENVIRONMENT=Staging

# Runtime DB role ONLY (fl_api_staging / fl_api_prod) on the pooled host. Never the owner role.
ConnectionStrings__FundLedger=postgresql://fl_api_staging:<password>@<pooler-host>/fundledger?sslmode=require&channel_binding=require

# Exact PWA origin(s) allowed by CORS (TR-071)
Cors__AllowedOrigins__0=https://staging.example.org

# Token signing key (REQUIRED: the API refuses to start without it). Create it once per environment on any computer with
# the .NET SDK or the API image:  dotnet FundLedger.Api.dll generate-jwt-key   and paste the "Auth__Jwt__SigningKeyPem=" line it prints.
Auth__Jwt__SigningKeyPem=

# Attachment storage (Cloudflare R2). Leave Provider empty until the bucket exists: uploads then say "not set up".
# Steps: docs/ops/attachments-storage.md
Storage__Provider=
Storage__S3__ServiceUrl=
Storage__S3__Bucket=
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=

# Optional until Sentry is set up
Sentry__Dsn=
